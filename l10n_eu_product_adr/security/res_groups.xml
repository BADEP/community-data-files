<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="res_groups_privilege_adr_goods" model="res.groups.privilege">
        <field name="name">ADR Goods</field>
        <field name="sequence" eval="100" />
        <field name="category_id" ref="base.module_category_services" />
    </record>
    <record id="group_adr_goods_user" model="res.groups">
        <field name="name">ADR Goods User</field>
        <field name="privilege_id" ref="res_groups_privilege_adr_goods" />
    </record>
    <record id="group_adr_goods_admin" model="res.groups">
        <field name="name">ADR Goods Administrator</field>
        <field name="implied_ids" eval="[Command.link(ref('group_adr_goods_user'))]" />
        <field name="privilege_id" ref="res_groups_privilege_adr_goods" />
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_adr_goods_user'))]" />
    </record>
    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_adr_goods_admin'))]" />
    </record>
</odoo>
